{
    "name": "tropic-rs-devcontainer",
    "image": "tropic-rs-devcontainer",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "remoteUser": "vscode",
    "privileged": true,
    "capAdd": [
        "SYS_PTRACE"
    ],
    "securityOpt": [
        "seccomp=unconfined"
    ],
    "mounts": [
        {
            "type": "bind",
            "source": "/dev/bus/usb",
            "target": "/dev/bus/usb"
        }
    ],
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": "true",
            "username": "vscode",
            "userUid": "1000",
            "userGid": "1000",
            "upgradePackages": "true"
        },
        "ghcr.io/devcontainers/features/git:1": {
            "version": "latest",
            "ppa": "false"
        }
    },
    "runArgs": [
        "--group-add=keep-groups",
        "--device=/dev/bus/usb",
        "--device=/dev/ttyACM0",
        "--device=2e8a:000c"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "vadimcn.vscode-lldb",
                "tamasfe.even-better-toml",
                "BarbossHack.crates-io",
                // https://probe.rs/docs/tools/debugger/
                "probe-rs.probe-rs-debugger"
            ]
        }
    }
}